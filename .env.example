# SolarSense AI — Environment Variables Template
# Copy this file to server/.env and fill in your confidential values.

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Database Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/solarsense_ai

# Authentication & Security Secrets
JWT_SECRET=your_jwt_secret_key_change_in_production
ADMIN_REGISTRATION_SECRET=your_admin_passphrase_change_in_production

# Google Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Python FastAPI Machine Learning Microservice
AI_SERVICE_URL=http://127.0.0.1:8000
