# SolarSense AI — Server Environment Variables Template
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/solarsense_ai

# Security Secrets
JWT_SECRET=your_jwt_secret_key_change_in_production
ADMIN_REGISTRATION_SECRET=your_admin_passphrase_change_in_production

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Python ML Service
AI_SERVICE_URL=http://127.0.0.1:8000
